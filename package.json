{
  "name": "ShuDesktop",
  "version": "1.3.30",
  "description": "electron demo",
  "main": "main.js",
  "scripts": {
    "start:main": "pnpm --filter @electron-monorepo/main start",
    "build:main": "pnpm --filter @electron-monorepo/main build",
    "build:preload": "pnpm --filter @electron-monorepo/preload build",
    "build:render": "pnpm --filter @electron-monorepo/render build",
    "build:shared": "pnpm --filter @electron-monorepo/shared build",
    "start:render": "pnpm --filter @electron-monorepo/render start",
    "build": "pnpm run build:shared && pnpm run build:preload && pnpm run build:render && pnpm run build:main",
    "build:precompiler": "electron-builder build --x64",
    "upload:oss": "node ./scripts/upload.ts",
    "major": "npm version major",
    "minor": "npm version minor",
    "patch": "npm version patch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "dependencies": {
    "@deno/kv": "catalog:",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@electron/get": "^3.0.0",
    "@types/ali-oss": "^6.23.3",
    "ali-oss": "^6.23.0",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.23",
    "electron": "catalog:",
    "electron-builder": "^26.15.3",
    "events": "^3.3.0",
    "qs": "^6.14.0",
    "typescript": "^6.0.3"
  },
  "build": {
    "productName": "创客",
    "appId": "com.xueliang.ShuDesktop",
    "directories": {
      "output": "release",
      "buildResources": "buildResources"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://xiangshuye.oss-cn-shanghai.aliyuncs.com/software/install/"
      }
    ],
    "asarUnpack": [
      "buildResources/exec",
      "node_modules/@deno"
    ],
    "asar": false,
    "files": [
      {
        "from": "apps/main/dist",
        "to": "."
      },
      {
        "from": "apps/render/dist",
        "to": "."
      },
      {
        "from": "buildResources",
        "to": "buildResources"
      },
      "package.json"
    ],
    "win": {
      "icon": "buildResources/icons/256x256.ico",
      "artifactName": "${productName}-v${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "deleteAppDataOnUninstall": true,
      "installerIcon": "buildResources/icons/256x256.ico",
      "createDesktopShortcut": true
    }
  }
}
