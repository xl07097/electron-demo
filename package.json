{
  "name": "ShuDesktop",
  "version": "1.4.3",
  "description": "electron desktop demo",
  "main": "main.js",
  "scripts": {
    "start:main": "pnpm --filter @desktop/main start",
    "start:render": "pnpm --filter @desktop/render start",
    "build:main": "pnpm --filter @desktop/main build",
    "build:preload": "pnpm --filter @desktop/preload build",
    "build:render": "pnpm --filter @desktop/render build",
    "build:shared": "pnpm --filter @desktop/shared build:tsc",
    "build": "pnpm run build:shared && pnpm run build:preload && pnpm run build:render && pnpm run build:main",
    "build:precompiler": "electron-builder build --x64 --dir",
    "build:package": "electron-builder --win --x64",
    "upload:oss": "node ./scripts/upload.ts",
    "create:release": "node ./scripts/create-release.ts",
    "major": "npm version major",
    "minor": "npm version minor",
    "patch": "npm version patch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "dependencies": {
    "@deno/kv": "catalog:",
    "electron-log": "catalog:",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@types/node": "catalog:",
    "ali-oss": "^6.23.0",
    "cross-env": "catalog:",
    "electron": "catalog:",
    "electron-builder": "^26.18.0",
    "typescript": "catalog:"
  },
  "build": {
    "productName": "创客",
    "appId": "com.xueliang.ShuDesktop",
    "directories": {
      "output": "release",
      "buildResources": "buildResources"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://xiangshuye.oss-cn-shanghai.aliyuncs.com/software/install/"
      }
    ],
    "asarUnpack": [
      "buildResources/exec",
      "node_modules/@deno"
    ],
    "asar": false,
    "files": [
      {
        "from": "apps/main/dist",
        "to": "."
      },
      {
        "from": "apps/render/dist",
        "to": "."
      },
      {
        "from": "buildResources",
        "to": "buildResources"
      },
      "package.json"
    ],
    "win": {
      "icon": "buildResources/icons/256x256.ico",
      "artifactName": "${productName}-${os}-${platform}-${arch}-v${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "deleteAppDataOnUninstall": true,
      "installerIcon": "buildResources/icons/256x256.ico",
      "createDesktopShortcut": true
    }
  }
}
